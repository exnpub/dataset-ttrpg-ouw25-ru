# Hugging Face Configuration
# ===========================
# Скопируйте этот файл в .env и заполните свои значения
# cp .env.example .env

# HF API Token для загрузки датасета на Hub
# Получить: https://huggingface.co/settings/tokens
# Требует прав: write (для создания/обновления датасетов)
HF_TOKEN=hf_your_token_here

# ID репозитория датасета на HF Hub
# Формат: username/dataset-name или organization/dataset-name
# Пример: exnihilum/ukrytoe-more-corpus
HF_REPO_ID=exnihilum/ukrytoe-more-corpus

# Вишибилити датасета (public или private)
# По умолчанию: private (рекомендуется)
HF_DATASET_VISIBILITY=private

# Optional: Git branch для версионирования датасета на HF
# По умолчанию: main
HF_BRANCH=main

# ===========================
# Прочие переменные (опционально)
# ===========================

# Путь к файлу корпуса (по умолчанию: content/chunks/chunks.jsonl)
CORPUS_PATH=content/chunks/chunks.jsonl

# Путь к FAISS индексу (по умолчанию: rag_index.faiss)
RAG_INDEX_PATH=rag_index.faiss

# Модель для эмбеддингов (по умолчанию: intfloat/multilingual-e5-small)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Ollama конфигурация (опционально, если используете локальную LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI API (опционально, если используете OpenAI)
# OPENAI_API_KEY=sk_your_key_here

# Логирование
LOG_LEVEL=INFO

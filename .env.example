# Hugging Face Configuration
# ===========================
# Скопируйте этот файл в .env и заполните свои значения
# cp .env.example .env

# HF API Token для загрузки датасета на Hub
# Получить: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# ID репозитория датасета на HF Hub
HF_REPO_ID=exnihilum/ttrpg-ouw25-ru

# Визибилити датасета (public или private)
HF_DATASET_VISIBILITY=public

# Git branch для версионирования датасета на HF
HF_BRANCH=main


# Kaggle Datasets Configuration
# ===========================
# API Token Kaggle
# Получить: https://www.kaggle.com/settings/api (кнопка "Generate New Token")
KAGGLE_TOKEN=your_kaggle_api_token_here

# ID датасета на Kaggle (формат: username/dataset-slug)
KAGGLE_REPO=exnihilum/ttrpg-ouw25-ru


# RAG и Local LLM Configuration
# ===========================
# Путь к файлу корпуса
CORPUS_PATH=content/chunks/chunks.jsonl

# Путь к FAISS индексу
RAG_INDEX_PATH=rag_index.faiss

# Модель для эмбеддингов
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Ollama конфигурация (локальная LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Логирование
LOG_LEVEL=INFO
